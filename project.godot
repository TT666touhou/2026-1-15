; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="2025-11-05"
run/main_scene="res://Scenes/World.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

BoardManager="*res://Scripts/Managers/BoardManager.gd"
TurnManager="*res://Scripts/Managers/TurnManager.gd"
PlayerResourceLedger="*res://Scripts/Managers/PlayerResourceLedger.gd"
GlobalSettings="*res://Scripts/Managers/GlobalSettings.gd"
AudioManager="*res://Scripts/Managers/AudioManager.gd"
DeckManager="*res://Scripts/Managers/DeckManager.gd"
PartyManager="*res://Scripts/Managers/PartyManager.gd"
AttackManager="*res://Scripts/Managers/AttackManager.gd"
DungeonManager="*res://Scripts/Managers/DungeonManager.gd"
SkillManager="*res://Scripts/Managers/SkillManager.gd"
SynergyManager="*res://Scripts/Managers/SynergyManager.gd"
EquipmentGenerator="*res://Scripts/Items/EquipmentGenerator.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=704
window/stretch/mode="canvas_items"

[gui]

common/drop_mouse_on_gui_input_disabled=true

