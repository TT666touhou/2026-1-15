[gd_resource type="Resource" script_class="UnitSkillData" load_steps=6 format=3]
[ext_resource type="Resource" path="res://Resources/Skills/CustomSkills/Effect_Penetration_100.tres" id="1_effect"]
[ext_resource type="Script" path="res://Scripts/SkillSystem/TargetingDefinition.gd" id="2_target"]
[ext_resource type="Script" path="res://Scripts/SkillSystem/UnitSkillData.gd" id="3_skill"]

[sub_resource type="Resource" id="Resource_selection"]
script = ExtResource("2_target")
scope_type = 0
aoe_radius = 0
origin_is_self = true
target_filter = 1
can_target_empty = false
pattern_7x7 = Array[bool]([])

[sub_resource type="Resource" id="Resource_effect_range"]
script = ExtResource("2_target")
scope_type = 9
aoe_radius = 10
origin_is_self = true
target_filter = 1
can_target_empty = false
pattern_7x7 = Array[bool]([])

[resource]
script = ExtResource("3_skill")
skill_name = "貫穿震擊"
description = "【移動後觸發】對 X 型無限距離（10格）內的敵人造成 100% STR 穿透傷害"
execution_mode = 1
targeting_type = 0
cooldown_turns = 3
scaling_configs = Array[Dictionary]([{
"stat": "str",
"weight": 1.0
}])
scaling_multiplier = 1.0
targeting = SubResource("Resource_selection")
effects = Array[Resource]([ExtResource("1_effect")])
is_move_skill = false
post_move_targeting = SubResource("Resource_effect_range")
post_move_effects = Array[Resource]([])

